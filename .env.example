# Copy this file to ".env" and fill in your real values.

# Get this from your PostgreSQL provider (e.g. Neon, Supabase, Railway) — Step 3 in the guide
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Get these from https://dashboard.stripe.com/test/apikeys — Step 5 in the guide
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxx"

# The URL your app runs on. Locally it's this. After deploying, change it to your Vercel URL.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
